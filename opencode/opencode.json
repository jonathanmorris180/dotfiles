{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-4-6",
  "autoupdate": true,
  "mcp": {
    "servers": {
      "trello": {
        "type": "remote",
        "url": "https://mcp.trello.com/v1"
      },
      "google-workspace": {
        "type": "local",
        "command": ["uvx", "workspace-mcp", "--tool-tier", "core"]
      }
    }
  }
}
